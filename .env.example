# ---- Database (matches docker-compose.yml; host port 5433 avoids clashing with a local Postgres) ----
DATABASE_URL=postgres://boardroom:boardroom@localhost:5433/boardroom

# ---- LLM provider ----
LLM_API_KEY=

# ---- S3 / R2 storage (private dev bucket; IAM user scoped to this bucket only) ----
S3_BUCKET=boardroom-dev
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: set for Cloudflare R2 or another S3-compatible endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com  (use S3_REGION=auto for R2)
S3_ENDPOINT=

# ---- Better Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the API server (where /api/auth/* is mounted)
BETTER_AUTH_URL=http://localhost:3000

# ---- Frontend ----
VITE_API_URL=http://localhost:3000
